<Window x:Class="calc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="450" Width="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Дисплей -->
        <TextBox x:Name="txtDisplay" Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10" 
                 FontSize="28" TextAlignment="Right" VerticalContentAlignment="Center" 
                 IsReadOnly="True" Text="0"/>

        <!-- Кнопки -->
        <Button Content="C" Grid.Row="1" Grid.Column="0" Margin="3" FontSize="20" Click="BtnC_Click"/>
        <Button Content="←" Grid.Row="1" Grid.Column="1" Margin="3" FontSize="20" Click="BtnBack_Click"/>
        <Button Content="/" Grid.Row="1" Grid.Column="2" Margin="3" FontSize="20" Click="BtnOperation_Click"/>
        <Button Content="*" Grid.Row="1" Grid.Column="3" Margin="3" FontSize="20" Click="BtnOperation_Click"/>

        <Button Content="7" Grid.Row="2" Grid.Column="0" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="8" Grid.Row="2" Grid.Column="1" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="9" Grid.Row="2" Grid.Column="2" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="-" Grid.Row="2" Grid.Column="3" Margin="3" FontSize="20" Click="BtnOperation_Click"/>

        <Button Content="4" Grid.Row="3" Grid.Column="0" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="5" Grid.Row="3" Grid.Column="1" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="6" Grid.Row="3" Grid.Column="2" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="+" Grid.Row="3" Grid.Column="3" Margin="3" FontSize="20" Click="BtnOperation_Click"/>

        <Button Content="1" Grid.Row="4" Grid.Column="0" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="2" Grid.Row="4" Grid.Column="1" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="3" Grid.Row="4" Grid.Column="2" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="=" Grid.Row="4" Grid.Column="3" Grid.RowSpan="2" Margin="3" FontSize="20" Click="BtnEquals_Click"/>

        <Button Content="0" Grid.Row="5" Grid.Column="0" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
        <Button Content="." Grid.Row="5" Grid.Column="1" Margin="3" FontSize="20" Click="BtnDot_Click"/>
    </Grid>
</Window>