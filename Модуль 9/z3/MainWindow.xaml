<Window x:Class="z3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <!-- Стилизация -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Форма слева -->
            <ColumnDefinition Width="*"/>
            <!-- Таблица справа -->
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ: ДОБАВЛЕНИЕ ЗАДАЧИ ===== -->
        <Border Grid.Column="0" Background="White" Padding="15" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Новая задача" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>

                <TextBlock Text="Название:"/>
                <TextBox x:Name="txtTitle"/>

                <TextBlock Text="Приоритет:"/>
                <ComboBox x:Name="cmbPriority" SelectedIndex="1">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <TextBlock Text="Срок выполнения:"/>
                <DatePicker x:Name="dpDeadline"/>

                <Button Content="Добавить задачу" Click="BtnAdd_Click" Height="35" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: список и действия -->
        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Отметить выполненной" Click="BtnComplete_Click" Background="#007BFF"/>
                <Button Content="Удалить" Click="BtnDelete_Click" Background="#DC3545"/>
                <Button Content="Проверить сроки" Click="BtnCheckDeadlines_Click" Background="#FFC107" Foreground="Black"/>
            </StackPanel>

            <!-- Таблица задач -->
            <DataGrid x:Name="dgTasks" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                    <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Выполнена" Binding="{Binding IsCompleted}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>