<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:z1"
        mc:Ignorable="d"
        Title="Учёт сотрудников" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- 5 строк: 3 для формы + 1 для кнопок + 1 для таблицы -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 4 столбца: надпись / поле / надпись / поле -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Строка 0: ФИО + Должность -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="ФИО:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtFullName" Grid.Row="0" Grid.Column="1"
                 Margin="5" Padding="3" Height="25"/>

        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="Должность:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtPosition" Grid.Row="0" Grid.Column="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Строка 1: Отдел + Зарплата -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Отдел:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDepartment" Grid.Row="1" Grid.Column="1"
                 Margin="5" Padding="3" Height="25"/>
        
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="Зарплата:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtSalary" Grid.Row="1" Grid.Column="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Строка 2: Дата приёма -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Дата приёма:" VerticalAlignment="Center" Margin="5"/>
        <DatePicker x:Name="dpHireDate" Grid.Row="2" Grid.Column="1"
                    Margin="5" Height="25"/>
        
        <!-- Строка 3: Кнопки -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="4"
                    Orientation="Horizontal" Margin="0,10,0,10">

            <Button x:Name="btnAdd" Content="Добавить"
                    Width="120" Height="30" Margin="5"
                    Click="btnAdd_Click"/>
            <Button x:Name="btnUpdate" Content="Редактировать"
                    Width="130" Height="30" Margin="5"
                    Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Content="Удалить"
                    Width="120" Height="30" Margin="5"
                    Click="btnDelete_Click"/>
            <Button x:Name="btnClear" Content="Очистить"
                    Width="120" Height="30" Margin="5"
                    Click="btnClear_Click"/>
        </StackPanel>
        
        <!-- Строка 4: Таблица-->
        <DataGrid x:Name="dgEmployees"
                  Grid.Row="4" Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="5"
                  SelectionChanged="dgEmployees_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="150"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Дата приёма" Binding="{Binding HireDate, StringFormat=dd.MM.yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>



    </Grid>
</Window>
