<Window x:Class="z2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт задач" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- 5 строк: 3 поля + статус и кнопки + таблица -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 4 столбца: надпись / поле / надпись / поле -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Строка 0: Название -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Название:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtTitle"
                 Grid.Row="0" Grid.Column="1"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Строка 1: Описание -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Описание:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDescription"
                 Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Строка 2: Приоритет + Срок -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Приоритет:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbPriority"
                  Grid.Row="2" Grid.Column="1"
                  Margin="5" Height="25" SelectedIndex="1">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text="Срок:" VerticalAlignment="Center" Margin="5"/>
        <DatePicker x:Name="dpDueDate"
                    Grid.Row="2" Grid.Column="3"
                    Margin="5" Height="25"/>

        <!-- Строка 3: Статус + Кнопки -->
        <CheckBox x:Name="chkCompleted"
                  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Выполнена" VerticalAlignment="Center"
                  Margin="5,10,5,10"/>

        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnAdd" Content="Добавить"
                    Width="100" Height="30" Margin="5"
                    Click="btnAdd_Click"/>
            <Button x:Name="btnUpdate" Content="Обновить"
                    Width="100" Height="30" Margin="5"
                    Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Content="Удалить"
                    Width="100" Height="30" Margin="5"
                    Click="btnDelete_Click"/>
            <Button x:Name="btnClear" Content="Очистить"
                    Width="100" Height="30" Margin="5"
                    Click="btnClear_Click"/>
        </StackPanel>

        <!-- Строка 4: Таблица задач -->
        <DataGrid x:Name="dgTasks"
                  Grid.Row="4" Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="5"
                  SelectionChanged="dgTasks_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridCheckBoxColumn Header="Выполнена" Binding="{Binding IsCompleted}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>