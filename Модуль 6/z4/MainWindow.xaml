<Window x:Class="z4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт финансов" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- 7 строк: поиск / 4 поля / сумма-статус / кнопки / итоги / таблица -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: поиск -->
            <RowDefinition Height="Auto"/>
            <!-- 1: дата + тип -->
            <RowDefinition Height="Auto"/>
            <!-- 2: категория + сумма -->
            <RowDefinition Height="Auto"/>
            <!-- 3: описание -->
            <RowDefinition Height="Auto"/>
            <!-- 4: кнопки -->
            <RowDefinition Height="Auto"/>
            <!-- 5: итоги -->
            <RowDefinition Height="*"/>
            <!-- 6: таблица -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Поиск -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Поиск:" VerticalAlignment="Center" Margin="5"
                   FontWeight="Bold"/>
        <TextBox x:Name="txtSearch"
                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                 Margin="5" Padding="3" Height="28" FontSize="13"
                 TextChanged="txtSearch_TextChanged"/>

        <!-- Дата + Тип -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Дата:" VerticalAlignment="Center" Margin="5"/>
        <DatePicker x:Name="dpDate"
                    Grid.Row="1" Grid.Column="1"
                    Margin="5" Height="25"/>

        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="Тип:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbType"
                  Grid.Row="1" Grid.Column="3"
                  Margin="5" Height="25" SelectedIndex="0"
                  SelectionChanged="cmbType_SelectionChanged">
            <ComboBoxItem Content="Доход"/>
            <ComboBoxItem Content="Расход"/>
        </ComboBox>

        <!-- Категория + Сумма -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Категория:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbCategory"
                  Grid.Row="2" Grid.Column="1"
                  Margin="5" Height="25" IsEditable="True"/>

        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text="Сумма:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtAmount"
                 Grid.Row="2" Grid.Column="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Описание -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Описание:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDescription"
                 Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="4"
                    Orientation="Horizontal" Margin="0,10,0,10">

            <Button x:Name="btnAdd" Content="Добавить"
                    Width="120" Height="35" Margin="5"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnUpdate" Content="Редактировать"
                    Width="130" Height="35" Margin="5"
                    Click="btnUpdate_Click"
                    Background="LightBlue"/>

            <Button x:Name="btnDelete" Content="Удалить"
                    Width="120" Height="35" Margin="5"
                    Click="btnDelete_Click"
                    Background="LightPink"/>

            <Button x:Name="btnClear" Content="Очистить"
                    Width="120" Height="35" Margin="5"
                    Click="btnClear_Click"/>

            <Button x:Name="btnShowAll" Content="Все записи"
                    Width="120" Height="35" Margin="5"
                    Click="btnShowAll_Click"/>
        </StackPanel>

        <!-- Итоги -->
        <Border Grid.Row="5" Grid.ColumnSpan="4"
                Background="LightYellow" Padding="10"
                BorderBrush="Gray" BorderThickness="1"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblIncome" FontSize="14" FontWeight="Bold"
                           Foreground="Green" Margin="0,0,30,0"
                           Text="Доходы: 0.00 руб."/>
                <TextBlock x:Name="lblExpense" FontSize="14" FontWeight="Bold"
                           Foreground="Red" Margin="0,0,30,0"
                           Text="Расходы: 0.00 руб."/>
                <TextBlock x:Name="lblBalance" FontSize="14" FontWeight="Bold"
                           Foreground="Blue"
                           Text="Баланс: 0.00 руб."/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid x:Name="dgTransactions"
                  Grid.Row="6" Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="5"
                  SelectionChanged="dgTransactions_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>