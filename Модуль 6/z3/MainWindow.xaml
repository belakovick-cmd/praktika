<Window x:Class="z3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- 6 строк: поиск / 4 поля / кнопки / таблица -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 4 столбца: надпись / поле / надпись / поле -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Строка 0: Поиск-->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Поиск:" VerticalAlignment="Center" Margin="5"
                   FontWeight="Bold"/>
        <TextBox x:Name="txtSearch"
                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                 Margin="5" Padding="3" Height="28"
                 FontSize="13"
                 TextChanged="txtSearch_TextChanged"/>

        <!-- Строка 1: Название  -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Название:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtTitle"
                 Grid.Row="1" Grid.Column="1"
                 Margin="5" Padding="3" Height="25"/>

        <!-- Строка 2: Автор + Год -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Автор:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtAuthor"
                 Grid.Row="2" Grid.Column="1"
                 Margin="5" Padding="3" Height="25"/>

        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text="Год:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtYear"
                 Grid.Row="2" Grid.Column="3"
                 Margin="5" Padding="3" Height="25"/>

        <!-- СТрока 3: Жанр + Статус -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Жанр:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbGenre"
                  Grid.Row="3" Grid.Column="1"
                  Margin="5" Height="25" SelectedIndex="0">
            <ComboBoxItem Content="Роман"/>
            <ComboBoxItem Content="Фантастика"/>
            <ComboBoxItem Content="Детектив"/>
            <ComboBoxItem Content="Поэзия"/>
            <ComboBoxItem Content="Научная"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="2"
                   Text="Статус:" VerticalAlignment="Center" Margin="5"/>
        <TextBlock x:Name="lblStatus"
                   Grid.Row="3" Grid.Column="3"
                   Text="Доступна" VerticalAlignment="Center" Margin="5"
                   FontWeight="Bold" Foreground="Green"/>

        <!-- Строка 4: Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="4"
                    Orientation="Horizontal" Margin="0,10,0,10">

            <Button x:Name="btnAdd" Content="Добавить"
                    Width="120" Height="35" Margin="5"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnRent" Content="Арендовать"
                    Width="120" Height="35" Margin="5"
                    Click="btnRent_Click"
                    Background="LightBlue"/>

            <Button x:Name="btnReturn" Content="Вернуть"
                    Width="120" Height="35" Margin="5"
                    Click="btnReturn_Click"
                    Background="LightGreen"/>

            <Button x:Name="btnDelete" Content="Удалить"
                    Width="120" Height="35" Margin="5"
                    Click="btnDelete_Click"
                    Background="LightPink"/>

            <Button x:Name="btnClear" Content="Очистить"
                    Width="120" Height="35" Margin="5"
                    Click="btnClear_Click"/>
        </StackPanel>

        <!-- Строка 5: Таблица книг -->
        <DataGrid x:Name="dgBooks"
                  Grid.Row="5" Grid.ColumnSpan="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="5"
                  SelectionChanged="dgBooks_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="200"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
                <DataGridTextColumn Header="Арендатор" Binding="{Binding Renter}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>